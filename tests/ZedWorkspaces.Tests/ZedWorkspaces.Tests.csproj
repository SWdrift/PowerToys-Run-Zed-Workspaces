<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PowerToysDirectory Condition="'$(PowerToysDirectory)' == ''">$(ProgramW6432)\PowerToys</PowerToysDirectory>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.1" PrivateAssets="all" />
    <ProjectReference Include="..\..\src\Community.PowerToys.Run.Plugin.ZedWorkspaces\Community.PowerToys.Run.Plugin.ZedWorkspaces.csproj" />
    <Reference Include="Wox.Plugin"><HintPath>$(PowerToysDirectory)\Wox.Plugin.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="Wox.Infrastructure"><HintPath>$(PowerToysDirectory)\Wox.Infrastructure.dll</HintPath><Private>true</Private></Reference>
  </ItemGroup>
</Project>
