<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Version>1.0.0</Version>
    <PowerToysDirectory Condition="'$(PowerToysDirectory)' == ''">$(ProgramW6432)\PowerToys</PowerToysDirectory>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Wox.Plugin"><HintPath>$(PowerToysDirectory)\Wox.Plugin.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Wox.Infrastructure"><HintPath>$(PowerToysDirectory)\Wox.Infrastructure.dll</HintPath><Private>false</Private></Reference>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
    <None Update="plugin.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Images\*.png" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\LICENSE" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="CheckPowerToysReferences" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(PowerToysDirectory)\Wox.Plugin.dll')" Text="Set -p:PowerToysDirectory to your PowerToys installation directory (requires PowerToys 0.102.3 / .NET 10 API)." />
  </Target>
</Project>
